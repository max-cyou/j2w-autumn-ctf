# Keep the intentionally vulnerable services on loopback by default.
BIND_ADDRESS=127.0.0.1

MEMO_DROP_PORT=8101
TELEMETRY_VAULT_PORT=8102
DOUBLE_VISION_PORT=8201
RECEIPT_PRINTER_PORT=8202
NULL_AUTHORITY_PORT=8301
OPEN_GALLERY_PORT=8302

# Per-container limits for a small demonstration deployment.
SERVICE_MEMORY_LIMIT=256m
SERVICE_CPU_LIMIT=1.0
SERVICE_PIDS_LIMIT=128
